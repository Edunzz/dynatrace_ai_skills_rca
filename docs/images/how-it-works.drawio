        <mxCell id="c12" value='&lt;b&gt;☁️ Dynatrace &amp;amp; docs&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;"&gt;Your data and official sources&lt;/span&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#ffffff;fillColor=#31323a;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="835" y="108" width="225" height="58" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b&gt;PREPARE&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;make sure everything needed is in place" style="rounded=1;arcSize=50;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fillColor=#31323a;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="1040" height="30" as="geometry"/></mxCell>
        <mxCell id="c14" value='&lt;b style="font-size:14px;"&gt;Ask for an RCA&lt;/b&gt;&lt;br&gt;“Do the RCA for P-1234” — or give an event, or a time range + service.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#31323a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="32" y="224" width="196" height="96" as="geometry"/></mxCell>
        <mxCell id="c15" value='&lt;b style="font-size:14px;"&gt;1 · Check prerequisites&lt;/b&gt;&lt;br&gt;Runs the checker before touching any data.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#e7eefb;strokeColor=#0b56e5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="234" width="262" height="74" as="geometry"/></mxCell>
        <mxCell id="c16" value='&lt;b style="font-size:14px;"&gt;check_prereqs.py&lt;/b&gt;&lt;br&gt;dtctl · login · permissions · dt-* skills · draw.io · Python. Installs nothing.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#f4f4f6;strokeColor=#8d8e96;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="602" y="226" width="206" height="90" as="geometry"/></mxCell>
        <mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#5c5d66;strokeWidth=2;fontColor=#31323a;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;dashPattern=5 4;strokeColor=#8d8e96;strokeWidth=1.5;fontColor=#5c5d66;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c19" value="Ready?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#31323a;fillColor=#e7eefb;strokeColor=#0b56e5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="371.0" y="334" width="120" height="76" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;b style=&quot;font-size:14px;&quot;&gt;STOP&lt;/b&gt;&lt;br&gt;You get what's missing and the exact command to fix each item." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#faeae9;strokeColor=#c80026;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="32" y="330" width="196" height="86" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#5c5d66;strokeWidth=2;fontColor=#31323a;fontStyle=1;" edge="1" parent="1" source="c15" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c22" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#c80026;strokeWidth=2;fontColor=#c80026;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c23" value="&lt;b style=&quot;font-size:14px;&quot;&gt;2 · Set the starting point&lt;/b&gt;&lt;br&gt;Problem, event or time range. Times in UTC + your machine's local time." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="440" width="262" height="80" as="geometry"/></mxCell>
        <mxCell id="c24" value='&lt;b style="font-size:14px;"&gt;Confirm the tenant&lt;/b&gt;&lt;br&gt;Is this the right Dynatrace environment?' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#31323a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="32" y="440" width="196" height="80" as="geometry"/></mxCell>
        <mxCell id="c25" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#5c5d66;strokeWidth=2;fontColor=#31323a;fontStyle=1;" edge="1" parent="1" source="c19" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#5c5d66;strokeWidth=2;fontColor=#31323a;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c27" value="&lt;b&gt;INVESTIGATE&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;find out what really happened" style="rounded=1;arcSize=50;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fillColor=#31323a;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="20" y="544" width="1040" height="30" as="geometry"/></mxCell>
        <mxCell id="c28" value='&lt;b style="font-size:14px;"&gt;3 · Investigate freely&lt;/b&gt;&lt;br&gt;Any lead, any data source, any time window.&lt;br&gt;&lt;span style="color:#0b56e5;"&gt;&lt;b&gt;↻&lt;/b&gt; hypothesis → query → confirm or rule out&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="594" width="262" height="130" as="geometry"/></mxCell>
        <mxCell id="c29" value='&lt;b style="font-size:14px;"&gt;Dynatrace for AI skills&lt;/b&gt;&lt;br&gt;How to query each domain: services, traces, logs, Kubernetes, cloud…' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#f4f4f6;strokeColor=#8d8e96;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="602" y="588" width="206" height="84" as="geometry"/></mxCell>
        <mxCell id="c30" value='&lt;b style="font-size:14px;"&gt;dtctl&lt;/b&gt;&lt;br&gt;Read-only queries' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#f4f4f6;strokeColor=#8d8e96;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="602" y="684" width="206" height="56" as="geometry"/></mxCell>
        <mxCell id="c31" value='&lt;b style="font-size:14px;"&gt;Your Dynatrace tenant&lt;/b&gt;&lt;br&gt;Grail: problems, metrics, traces, logs, events and topology' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#f4f4f6;strokeColor=#8d8e96;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="847" y="600" width="201" height="128" as="geometry"/></mxCell>
        <mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#5c5d66;strokeWidth=2;fontColor=#31323a;fontStyle=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="274" y="626"/><mxPoint x="274" y="698"/></Array></mxGeometry></mxCell>
        <mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;dashPattern=5 4;strokeColor=#8d8e96;strokeWidth=1.5;fontColor=#5c5d66;exitX=1;exitY=0.277;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;dashPattern=5 4;strokeColor=#8d8e96;strokeWidth=1.5;fontColor=#5c5d66;exitX=1;exitY=0.908;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#5c5d66;strokeWidth=2;fontColor=#31323a;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.875;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c36" value='&lt;b style="font-size:14px;"&gt;4 · Back every claim&lt;/b&gt;&lt;br&gt;Fact → saved query &lt;b&gt;Evidence N.x&lt;/b&gt;&lt;br&gt;Interpretation → + official doc &lt;b&gt;[Rn]&lt;/b&gt;&lt;br&gt;Not fully proven → ⚠️ hypothesis&lt;br&gt;Root cause: ✅ confirmed · ⚠️ probable · ❌ not determined' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="748" width="262" height="144" as="geometry"/></mxCell>
        <mxCell id="c37" value='&lt;b style="font-size:14px;"&gt;Official documentation&lt;/b&gt;&lt;br&gt;Dynatrace, Microsoft, Kubernetes and other vendors' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#f4f4f6;strokeColor=#8d8e96;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="847" y="777" width="201" height="86" as="geometry"/></mxCell>
        <mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#5c5d66;strokeWidth=2;fontColor=#31323a;fontStyle=1;" edge="1" parent="1" source="c28" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c39" value="cites" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;dashPattern=5 4;strokeColor=#8d8e96;strokeWidth=1.5;fontColor=#5c5d66;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c40" value="&lt;b&gt;DELIVER&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;a notebook anyone can read" style="rounded=1;arcSize=50;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fillColor=#31323a;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="20" y="916" width="1040" height="30" as="geometry"/></mxCell>
        <mxCell id="c41" value='&lt;b style="font-size:14px;"&gt;5 · Write the report&lt;/b&gt;&lt;br&gt;10 fixed sections. Opens with a summary anyone can understand.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="964" width="262" height="80" as="geometry"/></mxCell>
        <mxCell id="c42" value='&lt;b style="font-size:14px;"&gt;6 · Draw the diagrams&lt;/b&gt;&lt;br&gt;Propagation, timeline and 5 whys. Dynatrace colors; red = failure.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="1064" width="262" height="80" as="geometry"/></mxCell>
        <mxCell id="c43" value='&lt;b style="font-size:14px;"&gt;draw.io Desktop&lt;/b&gt;&lt;br&gt;+ any draw.io skill. Exports PNG.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#f4f4f6;strokeColor=#8d8e96;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="602" y="1064" width="206" height="80" as="geometry"/></mxCell>
        <mxCell id="c44" value='&lt;b style="font-size:14px;"&gt;7 · Build and validate&lt;/b&gt;&lt;br&gt;Embeds the images and checks the whole notebook.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#e7eefb;strokeColor=#0b56e5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="1164" width="262" height="74" as="geometry"/></mxCell>
        <mxCell id="c45" value='&lt;b style="font-size:14px;"&gt;build_notebook.py&lt;/b&gt;&lt;br&gt;Sections · evidence · references · plain-language summary · images' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#f4f4f6;strokeColor=#8d8e96;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="602" y="1156" width="206" height="90" as="geometry"/></mxCell>
