        <mxCell id="c53" value="Yes: fix" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#c80026;strokeWidth=2;fontColor=#c80026;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c46" target="c41"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="274" y="1300"/><mxPoint x="274" y="1004"/></Array></mxGeometry></mxCell>
        <mxCell id="c54" value='&lt;b style="font-size:14px;"&gt;8 · Publish&lt;/b&gt;&lt;br&gt;Dry run first, then publish to your tenant.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="1360" width="262" height="82" as="geometry"/></mxCell>
        <mxCell id="c55" value='&lt;b style="font-size:14px;"&gt;dtctl apply&lt;/b&gt;&lt;br&gt;&lt;i&gt;--dry-run&lt;/i&gt; runs every query; then the real publish' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#f4f4f6;strokeColor=#8d8e96;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="602" y="1360" width="206" height="82" as="geometry"/></mxCell>
        <mxCell id="c56" value='&lt;b style="font-size:14px;"&gt;📓 RCA notebook&lt;/b&gt;&lt;br&gt;In your tenant, ready to share. Every query can be re-run.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#eaf4ee;strokeColor=#007242;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="847" y="1352" width="201" height="98" as="geometry"/></mxCell>
        <mxCell id="c57" value='&lt;b style="font-size:14px;"&gt;You get&lt;/b&gt;&lt;br&gt;Notebook link · root cause in 3 lines with its certainty · editable diagrams' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#eaf4ee;strokeColor=#007242;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="32" y="1352" width="196" height="98" as="geometry"/></mxCell>
        <mxCell id="c58" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#5c5d66;strokeWidth=2;fontColor=#31323a;fontStyle=1;" edge="1" parent="1" source="c46" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
