        <mxCell id="c3" value="How the RCA skill works" style="text;html=1;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="22" width="1040" height="32" as="geometry"/></mxCell>
        <mxCell id="c4" value="Read it top to bottom. Each column is a participant; the numbers 1 → 8 are the steps the agent always follows. Free in how it investigates, strict in what it delivers." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#5c5d66;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="58" width="1040" height="40" as="geometry"/></mxCell>
