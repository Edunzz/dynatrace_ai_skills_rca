        <mxCell id="c6" value='&lt;b&gt;👤 You&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;"&gt;SRE · ops · on-call · anyone&lt;/span&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#ffffff;fillColor=#31323a;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="108" width="220" height="58" as="geometry"/></mxCell>
        <mxCell id="c7" value="" style="rounded=1;arcSize=3;html=1;fillColor=#fafafb;strokeColor=#e4e4e7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="255" y="108" width="320" height="1358" as="geometry"/></mxCell>
        <mxCell id="c8" value='&lt;b&gt;🤖 AI agent + RCA skill&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;"&gt;Any model · follows SKILL.md&lt;/span&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#ffffff;fillColor=#1966ff;gradientColor=#7d6afa;gradientDirection=east;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="255" y="108" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="c9" value="" style="rounded=1;arcSize=3;html=1;fillColor=#fafafb;strokeColor=#e4e4e7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="590" y="108" width="230" height="1358" as="geometry"/></mxCell>
        <mxCell id="c10" value='&lt;b&gt;🧰 Tools&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;"&gt;On your machine&lt;/span&gt;' style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#ffffff;fillColor=#31323a;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="108" width="230" height="58" as="geometry"/></mxCell>
