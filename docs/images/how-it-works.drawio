        <mxCell id="c62" value='&lt;b style="font-size:14px;"&gt;3 things that never bend&lt;/b&gt;&lt;br&gt;① Prerequisites pass before anything runs&lt;br&gt;② Every claim is backed by evidence&lt;br&gt;③ The delivery format is always the same' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#31323a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="1484" width="520" height="84" as="geometry"/></mxCell>
        <mxCell id="c63" value='&lt;b style="font-size:14px;"&gt;What the agent decides freely&lt;/b&gt;&lt;br&gt;What to query, in which order, which time windows and how deep to go — it can follow any lead.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#8d8e96;strokeWidth=1;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="560" y="1484" width="500" height="84" as="geometry"/></mxCell>
        <mxCell id="c64" value='&lt;b style="color:#0b56e5;"&gt;Blue&lt;/b&gt; automatic checks &amp;nbsp;·&amp;nbsp; &lt;b&gt;White&lt;/b&gt; agent work &amp;nbsp;·&amp;nbsp; &lt;b style="color:#5c5d66;"&gt;Gray&lt;/b&gt; tools and sources &amp;nbsp;·&amp;nbsp; &lt;b style="color:#c80026;"&gt;Red&lt;/b&gt; stop &amp;nbsp;·&amp;nbsp; &lt;b style="color:#007242;"&gt;Green&lt;/b&gt; what you get &amp;nbsp;·&amp;nbsp; dashed line = uses' style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#5c5d66;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1580" width="1040" height="22" as="geometry"/></mxCell>
