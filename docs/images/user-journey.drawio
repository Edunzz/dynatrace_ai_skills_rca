<mxfile host="drawio" type="device">
  <diagram id="user-journey" name="User journey">
    <mxGraphModel dx="1160" dy="560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="560" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#1966ff;gradientColor=#7d6afa;gradientDirection=east;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1160" height="8" as="geometry"/></mxCell>
        <mxCell id="c3" value="A typical RCA session" style="text;html=1;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="22" width="1120" height="32" as="geometry"/></mxCell>
        <mxCell id="c4" value="What you do, what the agent does and what you get at each stage." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#5c5d66;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="58" width="1120" height="26" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;1 · Install once&lt;/b&gt;" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#ffffff;fillColor=#1966ff;strokeColor=#ffffff;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="150" y="96" width="178" height="50" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;2 · Ask&lt;/b&gt;" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#ffffff;fillColor=#2d67fe;strokeColor=#ffffff;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="316" y="96" width="178" height="50" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;3 · Confirm&lt;/b&gt;" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#ffffff;fillColor=#4168fd;strokeColor=#ffffff;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="482" y="96" width="178" height="50" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;4 · Investigate&lt;/b&gt;" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#ffffff;fillColor=#5568fc;strokeColor=#ffffff;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="648" y="96" width="178" height="50" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;5 · Build&lt;/b&gt;" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#ffffff;fillColor=#6969fb;strokeColor=#ffffff;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="814" y="96" width="178" height="50" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;6 · Share&lt;/b&gt;" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#ffffff;fillColor=#7d6afa;strokeColor=#ffffff;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="980" y="96" width="178" height="50" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;You do&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#ffffff;fillColor=#31323a;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="118" height="104" as="geometry"/></mxCell>
        <mxCell id="c12" value="Install the skill, the Dynatrace for AI skills, a draw.io skill, dtctl and draw.io Desktop. Log dtctl in." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#31323a;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="156" y="160" width="158" height="104" as="geometry"/></mxCell>
        <mxCell id="c13" value="“Do the RCA for problem P-1234” — or give an event, or a time range + service." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#31323a;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="322" y="160" width="158" height="104" as="geometry"/></mxCell>
        <mxCell id="c14" value="Confirm it's the right tenant." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#31323a;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="488" y="160" width="158" height="104" as="geometry"/></mxCell>
        <mxCell id="c15" value="Nothing — or answer a question if the agent needs context." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#31323a;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="654" y="160" width="158" height="104" as="geometry"/></mxCell>
        <mxCell id="c16" value="Optional: review the draft." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#31323a;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="820" y="160" width="158" height="104" as="geometry"/></mxCell>
        <mxCell id="c17" value="Share the notebook with your team, management or customer." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#31323a;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="986" y="160" width="158" height="104" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b&gt;The agent does&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#ffffff;fillColor=#31323a;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="276" width="118" height="104" as="geometry"/></mxCell>
        <mxCell id="c19" value="Nothing yet. The skill loads by itself when you ask for an RCA." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="156" y="276" width="158" height="104" as="geometry"/></mxCell>
        <mxCell id="c20" value="Runs the prerequisite checker before touching any data." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="322" y="276" width="158" height="104" as="geometry"/></mxCell>
        <mxCell id="c21" value="Sets the starting point and your machine's time zone." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="488" y="276" width="158" height="104" as="geometry"/></mxCell>
        <mxCell id="c22" value="Queries your tenant read-only, tests and rules out hypotheses, saves every query as evidence." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="654" y="276" width="158" height="104" as="geometry"/></mxCell>
        <mxCell id="c23" value="Writes the report, draws the diagrams, validates everything and runs a dry run." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="820" y="276" width="158" height="104" as="geometry"/></mxCell>
        <mxCell id="c24" value="Publishes the notebook in your Dynatrace tenant." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="986" y="276" width="158" height="104" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;b&gt;You get&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#ffffff;fillColor=#007242;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="392" width="118" height="92" as="geometry"/></mxCell>
        <mxCell id="c26" value="An agent that knows how to run a Dynatrace RCA." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#eaf4ee;strokeColor=#b7d9c4;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="156" y="392" width="158" height="92" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;b&gt;READY&lt;/b&gt; — or the exact list of what's missing and how to fix it." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#eaf4ee;strokeColor=#b7d9c4;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="322" y="392" width="158" height="92" as="geometry"/></mxCell>
        <mxCell id="c28" value="A clear scope: what, where and when." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#eaf4ee;strokeColor=#b7d9c4;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="488" y="392" width="158" height="92" as="geometry"/></mxCell>
        <mxCell id="c29" value="Progress updates while it works." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#eaf4ee;strokeColor=#b7d9c4;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="654" y="392" width="158" height="92" as="geometry"/></mxCell>
        <mxCell id="c30" value="Nothing is published until every check passes." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#eaf4ee;strokeColor=#b7d9c4;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="820" y="392" width="158" height="92" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;b&gt;Notebook link&lt;/b&gt; · root cause in 3 lines with certainty · editable diagrams · action plan." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;spacing=9;align=left;verticalAlign=top;fontColor=#31323a;fillColor=#eaf4ee;strokeColor=#007242;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="986" y="392" width="158" height="92" as="geometry"/></mxCell>
        <mxCell id="c32" value="The agent never writes to your tenant until step 6, and it publishes only after the dry run passes. Your RCA working folder stays on your machine." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#5c5d66;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="502" width="1120" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
