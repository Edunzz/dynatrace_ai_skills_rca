<mxfile host="drawio" type="device">
  <diagram id="flujo" name="Flujo de la skill">
    <mxGraphModel dx="1500" dy="560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="560" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="f2" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#1966ff;gradientColor=#7d6afa;gradientDirection=east;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="8" as="geometry"/></mxCell>
        <mxCell id="f3" value="Cómo trabaja la skill dt-custom-rca-jromero" style="text;html=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1420" height="32" as="geometry"/></mxCell>
        <mxCell id="f4" value="Libre en la investigación; rígida en los prerrequisitos, en el sustento de cada afirmación y en el formato de entrega." style="text;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#5c5d66;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1420" height="24" as="geometry"/></mxCell>
        <mxCell id="f5" value="&lt;b&gt;1 · Prerrequisitos (gate)&lt;/b&gt;&lt;br&gt;&lt;br&gt;check_prereqs.py valida dtctl, contexto, permisos, skills dt-*, draw.io y Python. Si algo falta, se detiene y dice cómo resolverlo." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=10;align=left;verticalAlign=top;fillColor=#e7eefb;strokeColor=#0b56e5;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="f6" value="&lt;b&gt;2 · Ancla&lt;/b&gt;&lt;br&gt;&lt;br&gt;Problem ID, evento o rango + entidad. Hora local = zona horaria de la máquina (hora_local.py)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=10;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="410" y="110" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="f7" value="&lt;b&gt;3 · Investigación libre&lt;/b&gt;&lt;br&gt;&lt;br&gt;Solo lectura con dtctl. El agente elige qué consultar con las skills dt-obs-* (servicios, trazas, logs, Kubernetes, nube…)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=10;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="f8" value="&lt;b&gt;4 · Sustento&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cada hecho = Evidencia N.x (.dql reproducible). Cada interpretación = + documentación oficial [Rn]. Certeza declarada." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=10;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="1150" y="110" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="f9" value="&lt;b&gt;5 · Redacción&lt;/b&gt;&lt;br&gt;&lt;br&gt;Notebook de 10 secciones. Resumen ejecutivo que entiende cualquier persona; el detalle técnico va después." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=10;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="f10" value="&lt;b&gt;6 · Diagramas&lt;/b&gt;&lt;br&gt;&lt;br&gt;D1 propagación, D2 línea de tiempo y D3 cinco porqués, con draw.io y la paleta Strato de Dynatrace." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=10;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="410" y="330" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="f11" value="&lt;b&gt;7 · Ensamblado y validación&lt;/b&gt;&lt;br&gt;&lt;br&gt;build_notebook.py incrusta los PNG y valida formato, evidencias, referencias y legibilidad del resumen." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=10;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="780" y="330" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="f12" value="&lt;b&gt;8 · Publicación&lt;/b&gt;&lt;br&gt;&lt;br&gt;dtctl apply --dry-run y luego dtctl apply. Entrega: enlace al notebook, causa raíz y nivel de certeza." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=10;align=left;verticalAlign=top;fillColor=#eaf4ee;strokeColor=#007242;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="1150" y="330" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="f13" style="endArrow=block;endFill=1;html=1;strokeColor=#5c5d66;strokeWidth=2;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="f14" style="endArrow=block;endFill=1;html=1;strokeColor=#5c5d66;strokeWidth=2;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="f15" style="endArrow=block;endFill=1;html=1;strokeColor=#5c5d66;strokeWidth=2;" edge="1" parent="1" source="f7" target="f8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="f16" style="endArrow=block;endFill=1;html=1;strokeColor=#5c5d66;strokeWidth=2;" edge="1" parent="1" source="f8" target="f9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1310.0" y="285"/><mxPoint x="200.0" y="285"/></Array></mxGeometry></mxCell>
        <mxCell id="f17" style="endArrow=block;endFill=1;html=1;strokeColor=#5c5d66;strokeWidth=2;" edge="1" parent="1" source="f9" target="f10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="f18" style="endArrow=block;endFill=1;html=1;strokeColor=#5c5d66;strokeWidth=2;" edge="1" parent="1" source="f10" target="f11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="f19" style="endArrow=block;endFill=1;html=1;strokeColor=#5c5d66;strokeWidth=2;" edge="1" parent="1" source="f11" target="f12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="f20" value="Azul: control de entrada · Blanco: pasos que decide el agente · Verde: entrega. Si el gate falla, el RCA no empieza; si build_notebook.py falla, no se publica." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#5c5d66;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="1420" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
