<mxfile host="drawio" type="device">
  <diagram id="D1-propagation" name="D1-propagation">
    <mxGraphModel dx="1500" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="760" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#1966ff;gradientColor=#7d6afa;gradientDirection=east;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="8" as="geometry"/></mxCell>
        <mxCell id="c3" value="How the failure spread in the authorization service — P-2601001" style="text;html=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1420" height="32" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;How to read this diagram:&lt;/b&gt; the failure starts on the right (infrastructure) and travels left to the service's consumers. Red = origin and components with errors; the numbered red arrows show the order and the local time." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#5c5d66;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1420" height="36" as="geometry"/></mxCell>
        <mxCell id="c5" value="CONSUMERS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fafafb;strokeColor=#e4e4e7;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="300" height="340" as="geometry"/></mxCell>
        <mxCell id="c6" value="SERVICE" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fafafb;strokeColor=#e4e4e7;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="380" height="340" as="geometry"/></mxCell>
        <mxCell id="c7" value="INFRASTRUCTURE (.NET CONTAINERS ON KUBERNETES)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fafafb;strokeColor=#e4e4e7;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="840" y="120" width="620" height="340" as="geometry"/></mxCell>
        <mxCell id="c8" value='&lt;b&gt;Degraded&lt;/b&gt;&lt;br&gt;Consumer applications&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;9 requests with error 500 · waits of up to 81 s&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#fdf3dd;strokeColor=#d56b1a;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="65" y="245" width="250" height="96" as="geometry"/></mxCell>
        <mxCell id="c9" value='&lt;b&gt;With errors&lt;/b&gt;&lt;br&gt;Authorization service&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;auth-api · failure peak 9.4% (23:13)&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#faeae9;strokeColor=#c80026;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="425" y="245" width="330" height="96" as="geometry"/></mxCell>
        <mxCell id="c10" value='&lt;b&gt;ROOT CAUSE&lt;/b&gt;&lt;br&gt;Copy 1 of the service (pod …-a)&lt;br&gt;&lt;font style="font-size:10px" color="#ffffff"&gt;memory at 91% of the limit · garbage collection 99%&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#e01032;strokeColor=#c80026;strokeWidth=3;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="870" y="160" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="c11" value='&lt;b&gt;Healthy&lt;/b&gt;&lt;br&gt;Copy 2 of the service (pod …-b)&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;0 failures · collection 0% · memory 71% and rising&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#eaf4ee;strokeColor=#007242;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="870" y="335" width="270" height="96" as="geometry"/></mxCell>
        <mxCell id="c12" value='&lt;b&gt;Automatic action&lt;/b&gt;&lt;br&gt;Kubernetes restarts copy 1&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;23:14 · memory back to 119 MB&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#e7eefb;strokeColor=#0b56e5;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="1180" y="160" width="255" height="100" as="geometry"/></mxCell>
        <mxCell id="c13" value='&lt;b&gt;No visibility&lt;/b&gt;&lt;br&gt;Exact reason for the restart&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;the tenant receives no Kubernetes events&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#f4f4f6;strokeColor=#5c5d66;strokeWidth=1;dashed=1;dashPattern=6 4;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="1180" y="335" width="255" height="96" as="geometry"/></mxCell>
        <mxCell id="c14" value="① 23:12 · requests&lt;br&gt;stalled up to 81 s" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#c80026;strokeWidth=2;fontColor=#c80026;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c15" value="② 23:13 · 500 errors" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#c80026;strokeWidth=2;fontColor=#c80026;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c16" value="served 2,600 requests&lt;br&gt;with no failures" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#5c5d66;strokeWidth=1;fontColor=#5c5d66;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c17" value="③ 23:14" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#5c5d66;strokeWidth=1;fontColor=#5c5d66;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c18" value="" style="endArrow=none;html=1;strokeColor=#9ea0aa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="c13" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c19" value="&lt;b&gt;In one sentence:&lt;/b&gt; one of the two copies of the service came close to its memory limit, spent almost all its time freeing memory and stopped responding; the requests it received failed until Kubernetes restarted it. The other copy kept serving without errors, which is why the impact was limited (0.2% of requests)." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#5c5d66;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="1020" height="120" as="geometry"/></mxCell>
        <mxCell id="c20" value="Legend" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fafafb;strokeColor=#e4e4e7;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="1130" y="490" width="330" height="216" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#e01032;strokeColor=#c80026;strokeWidth=3;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1146" y="520" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="c22" value="Root cause (thick border)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1186" y="518" width="260" height="22" as="geometry"/></mxCell>
        <mxCell id="c23" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#faeae9;strokeColor=#c80026;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="1146" y="546" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="c24" value="With errors / failure" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1186" y="544" width="260" height="22" as="geometry"/></mxCell>
        <mxCell id="c25" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#fdf3dd;strokeColor=#d56b1a;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="1146" y="572" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="c26" value="Degraded" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1186" y="570" width="260" height="22" as="geometry"/></mxCell>
        <mxCell id="c27" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#eaf4ee;strokeColor=#007242;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="1146" y="598" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="c28" value="Healthy" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1186" y="596" width="260" height="22" as="geometry"/></mxCell>
        <mxCell id="c29" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#e7eefb;strokeColor=#0b56e5;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="1146" y="624" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="c30" value="Change / automatic action" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1186" y="622" width="260" height="22" as="geometry"/></mxCell>
        <mxCell id="c31" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#f4f4f6;strokeColor=#5c5d66;strokeWidth=1;dashed=1;dashPattern=6 4;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="1146" y="650" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="c32" value="No visibility / inconclusive" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1186" y="648" width="260" height="22" as="geometry"/></mxCell>
