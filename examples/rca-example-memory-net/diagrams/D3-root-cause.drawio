<mxfile host="drawio" type="device">
  <diagram id="D3-root-cause" name="D3-root-cause">
    <mxGraphModel dx="1500" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1080" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#1966ff;gradientColor=#7d6afa;gradientDirection=east;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="8" as="geometry"/></mxCell>
        <mxCell id="c3" value="Why the authorizations failed (5 whys) — P-2601001" style="text;html=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1420" height="32" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;How to read this diagram:&lt;/b&gt; from the top (what the customer experienced) down to the cause. In the center, the confirmed chain; on the sides, the factors that played a role and the ruled-out hypotheses." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#5c5d66;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1420" height="36" as="geometry"/></mxCell>
        <mxCell id="c5" value='&lt;b&gt;Symptom&lt;/b&gt;&lt;br&gt;9 authorizations failed (error 500) between 23:08 and 23:14&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;Ev. 2.1&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#faeae9;strokeColor=#c80026;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="490" y="120" width="520" height="78" as="geometry"/></mxCell>
        <mxCell id="c6" value='&lt;b&gt;Why?&lt;/b&gt;&lt;br&gt;One copy of the service kept requests waiting up to 81 s and returned an error&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;Ev. 5.2, 2.2&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="490" y="245" width="520" height="78" as="geometry"/></mxCell>
        <mxCell id="c7" value='&lt;b&gt;Why?&lt;/b&gt;&lt;br&gt;Its .NET process spent 91–99% of its time freeing memory, which pauses the application&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;Ev. 5.3 · R3&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="490" y="370" width="520" height="78" as="geometry"/></mxCell>
        <mxCell id="c8" value='&lt;b&gt;Why?&lt;/b&gt;&lt;br&gt;The container was at 91% of its 1 GiB limit; above 90%, .NET forces full clean-ups&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;Ev. 5.4 · R2&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="490" y="495" width="520" height="78" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;ROOT CAUSE&lt;/b&gt;&lt;br&gt;The service's memory grows 75–90 MB per hour in every copy and is only released by a restart&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#ffffff&quot;&gt;Ev. 5.7, 5.5&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#e01032;strokeColor=#c80026;strokeWidth=3;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="490" y="620" width="520" height="78" as="geometry"/></mxCell>
        <mxCell id="c10" value='&lt;b&gt;Why does it grow? (not confirmed)&lt;/b&gt;&lt;br&gt;Possible memory retention in the code (a leak or an unbounded cache); a memory analysis is missing&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;Gap G3&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#f4f4f6;strokeColor=#5c5d66;strokeWidth=1;dashed=1;dashPattern=6 4;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="490" y="745" width="520" height="78" as="geometry"/></mxCell>
        <mxCell id="c11" value="" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#5c5d66;strokeWidth=1;fontColor=#5c5d66;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c12" value="" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#5c5d66;strokeWidth=1;fontColor=#5c5d66;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c13" value="" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#5c5d66;strokeWidth=1;fontColor=#5c5d66;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c14" value="" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#5c5d66;strokeWidth=1;fontColor=#5c5d66;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c15" value="" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#5c5d66;strokeWidth=1;fontColor=#5c5d66;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c16" value="&lt;b&gt;Ruled out: general service failure&lt;/b&gt;&lt;br&gt;the other copy had no errors · Ev. 2.2, 5.1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#f4f4f6;strokeColor=#5c5d66;strokeWidth=1;dashed=1;fontColor=#5c5d66;fontStyle=8;" vertex="1" parent="1"><mxGeometry x="90" y="245" width="340" height="78" as="geometry"/></mxCell>
        <mxCell id="c17" value="" style="endArrow=none;html=1;strokeColor=#9ea0aa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="c16" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c18" value="&lt;b&gt;Mitigating factor&lt;/b&gt;&lt;br&gt;the other copy served 2,600 requests with no failures · Ev. 2.2" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#eaf4ee;strokeColor=#007242;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="1080" y="245" width="340" height="78" as="geometry"/></mxCell>
        <mxCell id="c19" value="" style="endArrow=none;html=1;strokeColor=#9ea0aa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="c18" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c20" value="&lt;b&gt;Inconclusive: previous change or deployment&lt;/b&gt;&lt;br&gt;no change events; the tenant does not receive them · Ev. 3.3" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#f4f4f6;strokeColor=#5c5d66;strokeWidth=1;dashed=1;dashPattern=6 4;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="90" y="370" width="340" height="78" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="endArrow=none;html=1;strokeColor=#9ea0aa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="c20" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c22" value="&lt;b&gt;Ruled out: memory exhausted (OOM)&lt;/b&gt;&lt;br&gt;peak usage 91%, it never reached the limit · Ev. 5.4" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#f4f4f6;strokeColor=#5c5d66;strokeWidth=1;dashed=1;fontColor=#5c5d66;fontStyle=8;" vertex="1" parent="1"><mxGeometry x="90" y="495" width="340" height="78" as="geometry"/></mxCell>
        <mxCell id="c23" value="" style="endArrow=none;html=1;strokeColor=#9ea0aa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="c22" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c24" value="&lt;b&gt;Contributing factor&lt;/b&gt;&lt;br&gt;no memory alert near the limit: 18 restarts in 48 h with no warning · Ev. 5.5, 5.6" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#fdf3dd;strokeColor=#d56b1a;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="1080" y="620" width="340" height="78" as="geometry"/></mxCell>
        <mxCell id="c25" value="" style="endArrow=none;html=1;strokeColor=#9ea0aa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="c24" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c26" value="&lt;b&gt;Unconfirmed hypothesis&lt;/b&gt;&lt;br&gt;the restart was caused by the Kubernetes liveness probe · R4" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#f4f4f6;strokeColor=#5c5d66;strokeWidth=1;dashed=1;dashPattern=6 4;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="1080" y="495" width="340" height="78" as="geometry"/></mxCell>
        <mxCell id="c27" value="" style="endArrow=none;html=1;strokeColor=#9ea0aa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="c26" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c28" value="Legend" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fafafb;strokeColor=#e4e4e7;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="1130" y="850" width="330" height="216" as="geometry"/></mxCell>
