<mxfile host="drawio" type="device">
  <diagram id="D1-propagacion" name="D1-propagacion">
    <mxGraphModel dx="1500" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="760" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#1966ff;gradientColor=#7d6afa;gradientDirection=east;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="8" as="geometry"/></mxCell>
        <mxCell id="c3" value="Cómo se propagó la falla en el servicio de autorización — P-2601001" style="text;html=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1420" height="32" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Cómo leer este diagrama:&lt;/b&gt; la falla nace a la derecha (infraestructura) y viaja hacia la izquierda hasta quienes consumen el servicio. Rojo = origen y componentes con errores; las flechas rojas numeradas muestran el orden y la hora local." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#5c5d66;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1420" height="36" as="geometry"/></mxCell>
        <mxCell id="c5" value="CONSUMIDORES" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fafafb;strokeColor=#e4e4e7;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="300" height="340" as="geometry"/></mxCell>
        <mxCell id="c6" value="SERVICIO" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fafafb;strokeColor=#e4e4e7;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="380" height="340" as="geometry"/></mxCell>
        <mxCell id="c7" value="INFRAESTRUCTURA (CONTENEDORES .NET EN KUBERNETES)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fafafb;strokeColor=#e4e4e7;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="840" y="120" width="620" height="340" as="geometry"/></mxCell>
        <mxCell id="c8" value='&lt;b&gt;Degradado&lt;/b&gt;&lt;br&gt;Aplicaciones consumidoras&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;9 consultas con error 500 · esperas de hasta 81 s&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#fdf3dd;strokeColor=#d56b1a;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="65" y="245" width="250" height="96" as="geometry"/></mxCell>
        <mxCell id="c9" value='&lt;b&gt;Con errores&lt;/b&gt;&lt;br&gt;Servicio de autorización&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;auth-api · pico de fallas 9,4 % (23:13)&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#faeae9;strokeColor=#c80026;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="425" y="245" width="330" height="96" as="geometry"/></mxCell>
        <mxCell id="c10" value='&lt;b&gt;CAUSA RAÍZ&lt;/b&gt;&lt;br&gt;Copia 1 del servicio (pod …-a)&lt;br&gt;&lt;font style="font-size:10px" color="#ffffff"&gt;memoria al 91 % del límite · recolección de basura 99 %&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#e01032;strokeColor=#c80026;strokeWidth=3;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="870" y="160" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="c11" value='&lt;b&gt;Sano&lt;/b&gt;&lt;br&gt;Copia 2 del servicio (pod …-b)&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;0 fallas · recolección 0 % · memoria 71 % y subiendo&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#eaf4ee;strokeColor=#007242;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="870" y="335" width="270" height="96" as="geometry"/></mxCell>
        <mxCell id="c12" value='&lt;b&gt;Acción automática&lt;/b&gt;&lt;br&gt;Kubernetes reinicia la copia 1&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;23:14 · la memoria vuelve a 119 MB&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#e7eefb;strokeColor=#0b56e5;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="1180" y="160" width="255" height="100" as="geometry"/></mxCell>
        <mxCell id="c13" value='&lt;b&gt;Sin visibilidad&lt;/b&gt;&lt;br&gt;Motivo exacto del reinicio&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;el tenant no recibe eventos de Kubernetes&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#f4f4f6;strokeColor=#5c5d66;strokeWidth=1;dashed=1;dashPattern=6 4;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="1180" y="335" width="255" height="96" as="geometry"/></mxCell>
        <mxCell id="c14" value="① 23:12 · solicitudes&lt;br&gt;colgadas hasta 81 s" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#c80026;strokeWidth=2;fontColor=#c80026;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c15" value="② 23:13 · errores 500" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#c80026;strokeWidth=2;fontColor=#c80026;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c16" value="atendió 2.600 solicitudes&lt;br&gt;sin fallas" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#5c5d66;strokeWidth=1;fontColor=#5c5d66;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c17" value="③ 23:14" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#5c5d66;strokeWidth=1;fontColor=#5c5d66;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c18" value="" style="endArrow=none;html=1;strokeColor=#9ea0aa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="c13" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c19" value="&lt;b&gt;En una frase:&lt;/b&gt; una de las dos copias del servicio llegó casi al tope de su memoria, pasó casi todo su tiempo liberándola y dejó de responder; las consultas que le tocaron fallaron hasta que Kubernetes la reinició. La otra copia siguió atendiendo sin errores, por eso el impacto fue acotado (0,2 % de las consultas)." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#5c5d66;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="1020" height="120" as="geometry"/></mxCell>
        <mxCell id="c20" value="Leyenda" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fafafb;strokeColor=#e4e4e7;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="1130" y="490" width="330" height="216" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#e01032;strokeColor=#c80026;strokeWidth=3;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1146" y="520" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="c22" value="Causa raíz (borde grueso)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1186" y="518" width="260" height="22" as="geometry"/></mxCell>
        <mxCell id="c23" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#faeae9;strokeColor=#c80026;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="1146" y="546" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="c24" value="Con errores / falla" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1186" y="544" width="260" height="22" as="geometry"/></mxCell>
        <mxCell id="c25" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#fdf3dd;strokeColor=#d56b1a;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="1146" y="572" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="c26" value="Degradado" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1186" y="570" width="260" height="22" as="geometry"/></mxCell>
        <mxCell id="c27" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#eaf4ee;strokeColor=#007242;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="1146" y="598" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="c28" value="Sano" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1186" y="596" width="260" height="22" as="geometry"/></mxCell>
        <mxCell id="c29" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#e7eefb;strokeColor=#0b56e5;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="1146" y="624" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="c30" value="Cambio / acción automática" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1186" y="622" width="260" height="22" as="geometry"/></mxCell>
        <mxCell id="c31" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#f4f4f6;strokeColor=#5c5d66;strokeWidth=1;dashed=1;dashPattern=6 4;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="1146" y="650" width="30" height="18" as="geometry"/></mxCell>
        <mxCell id="c32" value="Sin visibilidad / no concluyente" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1186" y="648" width="260" height="22" as="geometry"/></mxCell>
