        <mxCell id="c30" value="Causa raíz (borde grueso)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1186" y="878" width="260" height="22" as="geometry"/></mxCell>
