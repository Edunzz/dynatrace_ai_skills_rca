<mxfile host="drawio" type="device">
  <diagram id="D3-causa-raiz" name="D3-causa-raiz">
    <mxGraphModel dx="1500" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1080" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="" style="rounded=0;html=1;strokeColor=none;fillColor=#1966ff;gradientColor=#7d6afa;gradientDirection=east;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="8" as="geometry"/></mxCell>
        <mxCell id="c3" value="Por qué fallaron las autorizaciones (5 porqués) — P-2601001" style="text;html=1;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#31323a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1420" height="32" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Cómo leer este diagrama:&lt;/b&gt; de arriba (lo que vivió el cliente) hacia abajo (la causa). En el centro, la cadena confirmada; a los lados, factores que influyeron y las hipótesis descartadas." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#5c5d66;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1420" height="36" as="geometry"/></mxCell>
        <mxCell id="c5" value='&lt;b&gt;Síntoma&lt;/b&gt;&lt;br&gt;9 autorizaciones fallaron (error 500) entre 23:08 y 23:14&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;Ev. 2.1&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#faeae9;strokeColor=#c80026;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="490" y="120" width="520" height="78" as="geometry"/></mxCell>
        <mxCell id="c6" value='&lt;b&gt;¿Por qué?&lt;/b&gt;&lt;br&gt;Una copia del servicio dejó las consultas en espera hasta 81 s y respondió con error&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;Ev. 5.2, 2.2&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="490" y="245" width="520" height="78" as="geometry"/></mxCell>
        <mxCell id="c7" value='&lt;b&gt;¿Por qué?&lt;/b&gt;&lt;br&gt;Su proceso .NET pasó el 91–99 % del tiempo liberando memoria, y eso detiene la aplicación&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;Ev. 5.3 · R3&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="490" y="370" width="520" height="78" as="geometry"/></mxCell>
        <mxCell id="c8" value='&lt;b&gt;¿Por qué?&lt;/b&gt;&lt;br&gt;El contenedor estaba al 91 % de su límite de 1 GiB; sobre el 90 % .NET fuerza limpiezas completas&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;Ev. 5.4 · R2&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#5c5d66;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="490" y="495" width="520" height="78" as="geometry"/></mxCell>
        <mxCell id="c9" value='&lt;b&gt;CAUSA RAÍZ&lt;/b&gt;&lt;br&gt;La memoria del servicio crece 75–90 MB por hora en todas sus copias y solo se libera al reiniciar&lt;br&gt;&lt;font style="font-size:10px" color="#ffffff"&gt;Ev. 5.7, 5.5&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#e01032;strokeColor=#c80026;strokeWidth=3;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="490" y="620" width="520" height="78" as="geometry"/></mxCell>
        <mxCell id="c10" value='&lt;b&gt;¿Por qué crece? (no confirmado)&lt;/b&gt;&lt;br&gt;Posible retención de memoria en el código (fuga o caché sin límite); falta un análisis de memoria&lt;br&gt;&lt;font style="font-size:10px" color="#5c5d66"&gt;Brecha B3&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#f4f4f6;strokeColor=#5c5d66;strokeWidth=1;dashed=1;dashPattern=6 4;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="490" y="745" width="520" height="78" as="geometry"/></mxCell>
        <mxCell id="c11" value="" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#5c5d66;strokeWidth=1;fontColor=#5c5d66;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c12" value="" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#5c5d66;strokeWidth=1;fontColor=#5c5d66;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c13" value="" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#5c5d66;strokeWidth=1;fontColor=#5c5d66;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c14" value="" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#5c5d66;strokeWidth=1;fontColor=#5c5d66;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c15" value="" style="endArrow=block;endFill=1;html=1;fontFamily=Helvetica;strokeColor=#5c5d66;strokeWidth=1;fontColor=#5c5d66;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c16" value="&lt;b&gt;Descartada: falla general del servicio&lt;/b&gt;&lt;br&gt;la otra copia no tuvo errores · Ev. 2.2, 5.1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#f4f4f6;strokeColor=#5c5d66;strokeWidth=1;dashed=1;fontColor=#5c5d66;fontStyle=8;" vertex="1" parent="1"><mxGeometry x="90" y="245" width="340" height="78" as="geometry"/></mxCell>
        <mxCell id="c17" value="" style="endArrow=none;html=1;strokeColor=#9ea0aa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="c16" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c18" value="&lt;b&gt;Factor mitigante&lt;/b&gt;&lt;br&gt;la otra copia atendió 2.600 consultas sin fallas · Ev. 2.2" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#eaf4ee;strokeColor=#007242;strokeWidth=1;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="1080" y="245" width="340" height="78" as="geometry"/></mxCell>
        <mxCell id="c19" value="" style="endArrow=none;html=1;strokeColor=#9ea0aa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="c18" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c20" value="&lt;b&gt;No concluyente: cambio o despliegue previo&lt;/b&gt;&lt;br&gt;no hay eventos de cambio; el tenant no los recibe · Ev. 3.3" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#f4f4f6;strokeColor=#5c5d66;strokeWidth=1;dashed=1;dashPattern=6 4;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="90" y="370" width="340" height="78" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="endArrow=none;html=1;strokeColor=#9ea0aa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="c20" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c22" value="&lt;b&gt;Descartada: memoria agotada (OOM)&lt;/b&gt;&lt;br&gt;uso máximo 91 %, nunca llegó al límite · Ev. 5.4" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#f4f4f6;strokeColor=#5c5d66;strokeWidth=1;dashed=1;fontColor=#5c5d66;fontStyle=8;" vertex="1" parent="1"><mxGeometry x="90" y="495" width="340" height="78" as="geometry"/></mxCell>
        <mxCell id="c23" value="" style="endArrow=none;html=1;strokeColor=#9ea0aa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="c22" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c24" value="&lt;b&gt;Factor contribuyente&lt;/b&gt;&lt;br&gt;sin alerta de memoria cerca del límite: 18 reinicios en 48 h sin aviso · Ev. 5.5, 5.6" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#fdf3dd;strokeColor=#d56b1a;strokeWidth=2;fontColor=#31323a;" vertex="1" parent="1"><mxGeometry x="1080" y="620" width="340" height="78" as="geometry"/></mxCell>
        <mxCell id="c25" value="" style="endArrow=none;html=1;strokeColor=#9ea0aa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="c24" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c26" value="&lt;b&gt;Hipótesis no confirmada&lt;/b&gt;&lt;br&gt;el reinicio se debió a la sonda de vida de Kubernetes · R4" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;spacing=6;fillColor=#f4f4f6;strokeColor=#5c5d66;strokeWidth=1;dashed=1;dashPattern=6 4;fontColor=#5c5d66;" vertex="1" parent="1"><mxGeometry x="1080" y="495" width="340" height="78" as="geometry"/></mxCell>
        <mxCell id="c27" value="" style="endArrow=none;html=1;strokeColor=#9ea0aa;strokeWidth=1;dashed=1;" edge="1" parent="1" source="c26" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
